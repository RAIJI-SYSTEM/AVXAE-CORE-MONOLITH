<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mantém o log padrão do Spring Boot no console e adiciona uma trilha JSON
  dedicada à auditoria (logger "AUDIT"). Cada linha de auditoria sai como um
  objeto JSON puro no stdout, pronta para ser lida por Promtail/Loki.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="AUDIT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"avxae-core-monolith","log_type":"audit"}</customFields>
        </encoder>
    </appender>

    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_JSON"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
