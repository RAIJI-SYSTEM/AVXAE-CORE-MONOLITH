# =============================================================================
# Testes de carga do ecossistema Raiji (Locust)
#
# Copie para `.env` e ajuste. Todas as variáveis são lidas por raiji/config.py.
# =============================================================================

# --- Endereços ---------------------------------------------------------------
# Kong: único ponto de entrada do backend (monolito + chat + mídia + Keycloak)
RAIJI_GATEWAY=http://localhost:8000
# Next.js: BFF (/api/raiji/*, /api/chat/*) e SSR
RAIJI_FRONT=http://localhost:3000
# Keycloak direto — usado APENAS pelo seed de usuários de carga
RAIJI_KEYCLOAK_ADMIN=http://localhost:8180

# --- Autenticação ------------------------------------------------------------
RAIJI_REALM=raiji
RAIJI_CLIENT_ID=raiji-api
# Arquivo com usuários de carga (gerado por scripts/seed_test_users.py)
RAIJI_LOAD_USERS_FILE=users.csv

# --- Escopo desta suíte ------------------------------------------------------
RAIJI_MONOLITH_ENABLED=true
RAIJI_CHAT_ENABLED=false
RAIJI_FRONT_ENABLED=false

# --- Segurança dos testes ----------------------------------------------------
# Fluxos de escrita (criar carona, reservar, mensagens). Desligue para rodar
# carga somente-leitura em ambiente compartilhado.
RAIJI_ENABLE_WRITES=true
# Serviços externos pagos (Stripe, Infosimples, Resend). NUNCA ligue em massa.
RAIJI_ENABLE_EXTERNAL=false
# Upload real de bytes no S3/RustFS (banda + disco).
RAIJI_ENABLE_MEDIA_UPLOAD=false
RAIJI_HTTP_TIMEOUT=20

# --- Perfil de carga ---------------------------------------------------------
# 1200 usuários virtuais por padrão (não precisa passar parâmetro).
LOAD_PROFILE=load
LOAD_USERS=1200
LOAD_SPAWN=120
# Jornada de escrita: menor por segurança (cria caronas/reservas/mensagens)
JOURNEY_USERS=20
# load: rampa (s) + platô (s)
LOAD_RAMP=60
LOAD_HOLD=360
# outros perfis
SMOKE_HOLD=60
SPIKE_HOLD=120
SOAK_HOLD=3600
# stress: começa em, passo, duração de cada degrau
LOAD_START=200
LOAD_STEP=200
LOAD_STEP_TIME=120
