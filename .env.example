# Copie para .env (na raiz do monolith) e preencha: cp .env.example .env
# O docker compose lê este arquivo sozinho. O .env real NUNCA vai para o git.
# Linha vazia ou comentada = vale o padrão indicado.

# --- Endereço público (Kong) --------------------------------------------------
# Emissor dos tokens do Keycloak e links que o app usa. Para testar em celulares pelo Wi-Fi,
# rode ./scripts/dev-rede.sh: ele põe aqui o IP do PC (e ./scripts/dev-rede.sh localhost volta).
PUBLIC_BASE_URL=http://localhost:8000

# --- E-mails (Resend): https://resend.com/api-keys ----------------------------
# Sem chave, os e-mails não são enviados. Com onboarding@resend.dev só chega no e-mail da
# própria conta do Resend; para outros destinatários, verifique um domínio e use-o aqui.
RESEND_API_KEY=
RESEND_FROM=Raiji <onboarding@resend.dev>

# --- Pagamentos (Stripe): https://dashboard.stripe.com/test/apikeys -----------
# Chave SECRETA de teste (sk_test_...). A pública (pk_test_...) vai no raiji-app/.env.local.
STRIPE_API_KEY=
# Segredo do webhook (whsec_...): stripe listen, ou Developers > Webhooks no painel
STRIPE_WEBHOOK_SECRET=

# --- Verificação da CNH (Infosimples): https://infosimples.com -----------------
# Cada verificação real gasta créditos da conta.
INFO_SIMPLES_KEY=
# Login gov.br: só para RAIJI_DRIVER_VERIFICATION_CHECK=senatran
INFOSIMPLES_GOVBR_CPF=
INFOSIMPLES_GOVBR_SENHA=
# true = aprova o motorista sem conferir a CNH (só testes; nunca em produção)
RAIJI_DRIVER_VERIFICATION_SKIP=false
# photo = só a foto (nome e validade); senatran = foto + base da SENATRAN (pede o código de
# segurança; a Infosimples só libera para contas com CNPJ)
RAIJI_DRIVER_VERIFICATION_CHECK=photo

# --- Regras do negócio ----------------------------------------------------------
# Comissão da plataforma (%), descontada do motorista
RAIJI_PLATFORM_FEE_PERCENT=1.5
# true = viagens entre cidades só para motoristas com CNPJ/MEI
RAIJI_INTERMUNICIPAL_REQUIRES_BUSINESS=false
# true = anúncios simulados contam como recompensa (só desenvolvimento)
RAIJI_REWARDS_MOCK_ADS=true

# --- Arquivos: RustFS local (padrão) ou S3 da AWS --------------------------------
# Padrão: RustFS do compose, nada a preencher. Para usar o S3, descomente tudo abaixo e
# rode uma vez ./scripts/s3-aws-setup.sh (veja docker-compose.s3.yml).
#COMPOSE_FILE=docker-compose.yml:docker-compose.s3.yml
#AWS_S3_REGION=sa-east-1
#AWS_S3_ACCESS_KEY_ID=
#AWS_S3_SECRET_ACCESS_KEY=
#S3_MEDIA_BUCKET=
#S3_DOCS_BUCKET=

# --- Chat -----------------------------------------------------------------------
# Pasta do raiji-chat (só se não estiver ao lado do monolith)
#CHAT_CONTEXT=../raiji-chat

# --- Push (Firebase) --------------------------------------------------------------
# Não é variável: salve o JSON da conta de serviço em secrets/firebase-service-account.json
