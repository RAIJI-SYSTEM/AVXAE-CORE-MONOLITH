    {
      "id": 6,
      "type": "table",
      "title": "Auditoria durável — Postgres audit_log",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 72
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-auditoria"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT created_at AS \"Quando\", actor_sub AS \"Ator\", action AS \"Ação\", entity_type AS \"Recurso\", entity_id AS \"ID\", details AS \"Detalhes\" FROM audit_log WHERE (action ILIKE '%$busca_sql%' OR actor_sub ILIKE '%$busca_sql%' OR details ILIKE '%$busca_sql%') ORDER BY created_at DESC LIMIT 100",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Identidade — Keycloak (login/logout e admin events)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 82
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"raiji-keycloak-events\"} |= \"keycloak_event\" | json | username=~\"$usuario\" or actorUsername=~\"$usuario\" or userId=~\"$usuario\" or actorId=~\"$usuario\" |~ \"$busca\" | line_format \"{{.username}}{{.actorUsername}} | {{.kind}} | {{.type}} | {{.resourcePath}} | {{.ipAddress}}{{.actorIp}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
