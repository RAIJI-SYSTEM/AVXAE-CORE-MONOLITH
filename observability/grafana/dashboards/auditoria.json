    {
      "id": 9,
      "type": "text",
      "title": "Links e comandos úteis",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 102
      },
      "options": {
        "mode": "markdown",
        "content": "### Onde ver cada log\n\n- [Logs dos testes — monólito](http://127.0.0.1:8090/AVXAE-CORE-MONOLITH/reports/testes/logs/)\n- [Logs dos testes — FRONT](http://127.0.0.1:8090/FRONT-PWA/reports/testes/logs/)\n- [Logs dos testes — MESSAGE](http://127.0.0.1:8090/MESSAGE-SERVICE/reports/testes/logs/)\n- [Relatórios HTML — monólito](http://127.0.0.1:8090/AVXAE-CORE-MONOLITH/reports/)\n- [Keycloak Events](http://localhost:8180/admin/master/console/)\n- [Visão de negócio](http://localhost:3300/d/raiji-auditoria-negocio)\n\n### Comandos\n\n```bash\ndocker logs -f raiji-app\ndocker logs -f raiji-chat\ndocker logs -f raiji-front\ndocker logs -f raiji-keycloak\n```\n\n### APIs de auditoria\n\n```text\nGET /api/audit/me\nGET /api/admin/audit\nGET /chat/audit/me\nGET /chat/audit/events\n```"
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Usuários ativos (24h)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 108
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (actor_username) (count_over_time({container=~\"raiji-(app|chat)\"} |= \"audit_http_request\" | json | actor_username=~\".+\" [24h])))",
          "instant": true,
          "queryType": "instant",
          "legendFormat": "Monólito/Chat"
        },
        {
          "refId": "B",
          "expr": "count(count by (actorUsername) (count_over_time({container=\"raiji-front\"} |= \"\\\"service\\\":\\\"front-pwa\\\"\" | json | actorUsername=~\".+\" [24h])))",
          "instant": true,
          "queryType": "instant",
          "legendFormat": "Front"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Monólito/Chat"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Front"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 23,
      "type": "table",
      "title": "Usuários — o que estão fazendo (monólito/chat)",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 112
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(50, sum by (actor_username, action) (count_over_time({container=~\"raiji-(app|chat)\"} |= \"audit_http_request\" | json | actor_username=~\".+\" [24h])))",
          "instant": true,
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "actor_username": "Usuário",
              "action": "Ação",
              "Value": "Ações",
              "Value #A": "Ações"
            },
            "indexByName": {
              "Usuário": 0,
              "Ação": 1,
              "Ações": 2
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Ações",
            "desc": true
          }
        ]
      }
    },
