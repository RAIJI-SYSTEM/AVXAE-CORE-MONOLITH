    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs dos testes — relatórios de execução",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
