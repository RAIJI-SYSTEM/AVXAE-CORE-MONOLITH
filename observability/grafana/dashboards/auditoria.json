    {
      "id": 6,
      "type": "table",
      "title": "Auditoria durável — Postgres audit_log",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-auditoria"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT created_at AS \"Quando\", actor_sub AS \"Ator\", action AS \"Ação\", entity_type AS \"Recurso\", entity_id AS \"ID\", details AS \"Detalhes\" FROM audit_log ORDER BY created_at DESC LIMIT 100",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Identidade — Keycloak (login/logout e admin events)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 68
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"raiji-keycloak-events\"} |= \"keycloak_event\" | json | line_format \"{{.username}}{{.actorUsername}} | {{.kind}} | {{.type}} | {{.resourcePath}} | {{.ipAddress}}{{.actorIp}}\"",
