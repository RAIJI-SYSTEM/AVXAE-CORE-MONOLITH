      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"raiji-app\"} |= \"audit_http_request\" | json | event=\"http_request\" | http_status=~\"4..|5..\" |~ \"$busca\" | line_format \"{{.actor_username}} | {{.action}} | {{.http_method}} {{.http_path}} | {{.http_status}} | {{.duration_ms}}ms | {{.request_id}}\"",
          "queryType": "range"
        },
        {
          "refId": "B",
          "expr": "{container=\"raiji-chat\"} |= \"audit_http_request\" | json | audit=\"true\" | http_status=~\"4..|5..\" |~ \"$busca\" | line_format \"{{.actor_username}} | {{.action}} | {{.http_method}} {{.http_path}} | {{.http_status}} | {{.duration_ms}}ms | {{.request_id}}\"",
          "queryType": "range"
        },
        {
          "refId": "C",
          "expr": "{container=\"raiji-front\"} |= \"\\\"service\\\":\\\"front-pwa\\\"\" | json | event=\"bff_request\" | status=~\"4..|5..\" |~ \"$busca\" | line_format \"{{.actorUsername}} | {{.event}} | {{.method}} {{.path}} | {{.status}} | {{.requestId}}\"",
          "queryType": "range"
        },
        {
          "refId": "D",
          "expr": "{container=\"raiji-keycloak-events\"} |= \"keycloak_event\" | json | event=\"keycloak_event\" | error=~\".+\" |~ \"$busca\" | line_format \"{{.username}} | {{.type}} | {{.resourcePath}} | {{.actorUsername}} | {{.ipAddress}}\"",
          "queryType": "range"
        },
        {
          "refId": "E",
          "expr": "{container=\"raiji-keycloak\"} |~ \"LOGIN_ERROR|LOGOUT_ERROR|ERROR\" |~ \"$busca\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
