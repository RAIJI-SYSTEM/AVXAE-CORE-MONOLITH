        "multi": true,
        "includeAll": true,
        "allValue": "app|chat|front",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "usuario",
        "label": "Usuário (nome ou sub)",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "hide": 0
      },
      {
