# Copie para keycloak/.env e preencha: cp keycloak/.env.example keycloak/.env
# Login com Google. Depois rode ./scripts/keycloak-configure-auth.sh. Vazio = sem Google.
# Crie em https://console.cloud.google.com/apis/credentials (ID do cliente OAuth, aplicativo da Web)
# com o redirect: <PUBLIC_BASE_URL>/realms/raiji/broker/google/endpoint
# O Google só aceita localhost ou HTTPS: não funciona pelo IP da rede.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
